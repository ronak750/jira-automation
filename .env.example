# Jira Configuration
# Your Jira Cloud base URL (e.g. https://yourcompany.atlassian.net)
JIRA_BASE_URL=https://yourcompany.atlassian.net

# Atlassian account email
JIRA_USER_EMAIL=you@company.com

# Jira API Token (Generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_jira_api_token_here

# Issue link type to associate newly created issues with the story (e.g. Relates, Blocks, Cloners)
JIRA_LINK_TYPE=Relates

# Comma-separated list of issue types to create for the story (must match Jira issue types exactly)
JIRA_ISSUE_TYPES=Test Set,Test Plan,Test Execution

# Feature flag: automatically transition newly created tickets through workflow to close/done state (default: true)
AUTO_CLOSE_ISSUES=true

# Default workflow progression steps (supports '>' or ',' as separators)
# Example: "TO DO > IN REVIEW > DONE" or "TO DO, IN REVIEW, DONE"
WORKFLOW_STEPS="TO DO > IN REVIEW > DONE"

# Optional per-issue-type workflow overrides (uncomment and customize if needed):
# WORKFLOW_STEPS_TEST_SET="TO DO > IN REVIEW > DONE"
# WORKFLOW_STEPS_TEST_PLAN="TO DO > IN REVIEW > DONE"
# WORKFLOW_STEPS_TEST_EXECUTION="TO DO > IN REVIEW > DONE"

